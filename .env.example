# Optional dedicated RPC. Public mainnet is used when this is unset.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Comma-separated backup RPCs used when the primary fails.
SOLANA_RPC_FALLBACKS=https://solana-rpc.publicnode.com
# Override the SOL/USD quote (skips CoinGecko and Jupiter).
# SOL_PRICE_USD=150
PORT=43123
HOST=0.0.0.0
